# Folder containing the current WebExpress *.nupkg packages used for the container build.
WEBEXPRESS_FEED=

# Persistent application directory on the Docker host.
VILA_DIR=/opt/vila

# Signing key of the sign-in tokens, at least 256 random bits in Base64. Required.
# Generate one with: openssl rand -base64 32
VILA_SIGNING_KEY=

VILA_GPIO_CHIP=0
VILA_GPIO_GID=

# Port on the host the application answers on.
VILA_PORT=8080

# Public base URI used for redirects and generated absolute URLs. Adjust it when a reverse proxy
# or a public DNS name exposes the container.
VILA_EXTERNAL_URI=http://vila:8080/
